# Modo local seguro por padrão. Demo usa somente dados fictícios no localStorage.
VITE_APP_DATA_MODE=demo
VITE_APP_ENV=local

# Para cloud local, inicie o Supabase local e altere o modo para cloud.
# Cloud local aceita somente http://localhost:54321 ou http://127.0.0.1:54321.
# VITE_SUPABASE_URL=http://127.0.0.1:54321
# VITE_SUPABASE_ANON_KEY=sua-chave-publica-do-supabase-local

# Nunca configure service_role, sb_secret_ ou qualquer segredo administrativo em VITE_*.
# Produção Vercel exige VITE_APP_DATA_MODE=cloud, VITE_APP_ENV=production e o projeto
# de produção mapeado em 01.3. Preview deve usar VITE_APP_DATA_MODE=demo e
# VITE_APP_ENV=preview até existir um projeto Supabase de homologação separado.
